# Builds any of the Flutter web targets and serves the bundle via nginx.
#
# Both apps depend on packages/lizmo_ui through a path dependency, so the build
# context is the repo root — not the app directory.
#
#   docker build -f Dockerfile.flutter-web --build-arg APP=admin .
#
# The SDK is installed at an exact tag rather than pulled from a prebuilt image:
# ghcr.io/cirruslabs/flutter has no 3.44.9 tag, and its `stable` tag floats,
# which would make builds non-reproducible.
FROM debian:bookworm-slim AS build

ARG FLUTTER_VERSION=3.44.9

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl unzip xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" \
      https://github.com/flutter/flutter.git /flutter \
    && git config --global --add safe.directory /flutter
ENV PATH="/flutter/bin:/flutter/bin/cache/dart-sdk/bin:${PATH}"
RUN flutter precache --web

# Which app to build: `admin` or `mobile`.
ARG APP=admin

# Where the built app looks for the API.
#
# Baked in at build time because that is the only time a Flutter web bundle can
# be told anything: --dart-define is compiled in, and there is no environment
# left to read at runtime. Empty means ApiConfig's own default, which is
# localhost:8082 -- right on this machine, useless once deployed, and silent
# about it either way.
ARG API_BASE_URL=
WORKDIR /src

# Every local package is copied, not just the ones an app names directly:
# lizmo_core pulls in lizmo_api, and a path dependency that is absent fails
# `pub get` with a bare exit 66. Copying packages/ wholesale means adding a
# package never silently breaks this build.
COPY packages packages
COPY ${APP}/pubspec.yaml ${APP}/pubspec.lock ./${APP}/
RUN cd ${APP} && flutter pub get

COPY ${APP} ./${APP}

# No service worker.
#
# Flutter web ships one by default, and it serves its own cached copy of the
# app regardless of what nginx says -- so a deploy can be live, verified, and
# still invisible to somebody with the tab open, with nothing to indicate
# anything is wrong. That happened: a console deployed with a new section in
# its navigation kept showing the old one.
#
# These are a staff console and a preview build. Neither needs to work offline,
# and neither is worth a whole category of "did my deploy actually work".
RUN cd ${APP} && \
    if [ -n "${API_BASE_URL}" ]; then \
      flutter build web --release --pwa-strategy=none \
        --dart-define=LIZMO_API_BASE_URL="${API_BASE_URL}"; \
    else \
      flutter build web --release --pwa-strategy=none; \
    fi

FROM nginx:1.27-alpine
# Re-declared after FROM: ARGs do not carry across build stages.
ARG APP=admin
COPY --from=build /src/${APP}/build/web /usr/share/nginx/html
COPY infra/nginx/flutter-web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
