{
    "openapi": "3.0.1",
    "info": {
        "title": "OpenAPI definition",
        "version": "v0"
    },
    "servers": [
        {
            "url": "http://localhost:8082",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Auth",
            "description": "Registration, login and token lifecycle"
        }
    ],
    "paths": {
        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Create an account",
                "description": "Always creates a tenant profile; adds a landlord profile when asLandlord is true.",
                "operationId": "register",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Account created, tokens issued",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Email or phone already registered",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation failed, or neither email nor phone given",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Exchange a refresh token for a new pair",
                "description": "The presented refresh token is revoked, so each one is usable exactly once.",
                "operationId": "refresh",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RefreshRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "New tokens issued",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Refresh token unknown, expired or already used",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Revoke a refresh token",
                "description": "Idempotent: unknown or already-revoked tokens still return 204.",
                "operationId": "logout",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RefreshRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Sign in with email or phone plus password",
                "operationId": "login",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "401": {
                        "description": "Credentials rejected",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Tokens issued",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RegisterRequest": {
                "required": [
                    "name",
                    "password"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "maxLength": 255,
                        "minLength": 0,
                        "type": "string",
                        "example": "Ana Reyes"
                    },
                    "email": {
                        "maxLength": 255,
                        "minLength": 0,
                        "type": "string",
                        "description": "Required unless phone is given",
                        "example": "ana@example.com"
                    },
                    "phone": {
                        "maxLength": 20,
                        "minLength": 0,
                        "type": "string",
                        "description": "Required unless email is given",
                        "example": "09171234567"
                    },
                    "password": {
                        "maxLength": 100,
                        "minLength": 8,
                        "type": "string",
                        "example": "correct-horse-battery"
                    },
                    "asLandlord": {
                        "type": "boolean",
                        "description": "Create a landlord profile as well as a tenant one",
                        "default": false
                    }
                },
                "description": "New account details"
            },
            "ApiError": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "example": "INVALID_CREDENTIALS"
                    },
                    "message": {
                        "type": "string",
                        "example": "Email or password is incorrect."
                    },
                    "fields": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "description": "Standard error response"
            },
            "AuthResponse": {
                "type": "object",
                "properties": {
                    "accessToken": {
                        "type": "string",
                        "description": "Short-lived bearer token"
                    },
                    "refreshToken": {
                        "type": "string",
                        "description": "Long-lived token, exchanged for new access tokens"
                    },
                    "expiresIn": {
                        "type": "integer",
                        "description": "Access token lifetime in seconds",
                        "format": "int64",
                        "example": 3600
                    },
                    "userId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "profiles": {
                        "type": "array",
                        "example": [
                            "TENANT"
                        ],
                        "items": {
                            "type": "string",
                            "example": "[\"TENANT\"]"
                        }
                    }
                },
                "description": "Issued tokens and the identity they belong to"
            },
            "RefreshRequest": {
                "required": [
                    "refreshToken"
                ],
                "type": "object",
                "properties": {
                    "refreshToken": {
                        "type": "string"
                    }
                },
                "description": "Exchange a refresh token for a new access token"
            },
            "LoginRequest": {
                "required": [
                    "identifier",
                    "password"
                ],
                "type": "object",
                "properties": {
                    "identifier": {
                        "type": "string",
                        "description": "Email address or phone number",
                        "example": "ana@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "correct-horse-battery"
                    }
                },
                "description": "Login credentials"
            }
        }
    }
}
